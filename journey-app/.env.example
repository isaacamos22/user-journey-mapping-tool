# Copy to .env for local development. Production uses PostgreSQL on Azure (see README).

# SQLite path. On Windows + OneDrive, use a local (non-synced) path or writes fail with "readonly database":
# Local SQLite — journey data is NOT in git. Optional outside OneDrive:
# DATABASE_URL="file:C:/Users/<you>/AppData/Local/journey-mapping-tool/dev.db"
DATABASE_URL="file:./dev.db"

# Local workbench (recommended): no login, no sharing UI — collaborate in Figma, import PDF here.
LOCAL_DEFAULT_USER_EMAIL="facilitator@example.com"
LOCAL_MODE="true"

# --- Production (Azure App Service) ---
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/journey?sslmode=require"
# LOCAL_MODE="false"
# AUTH_SECRET=""                    # openssl rand -base64 32
# AUTH_URL="https://your-app.azurewebsites.net"
# AUTH_MICROSOFT_ENTRA_ID_ID=""
# AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=""
# Redirect URI in Entra: https://<host>/api/auth/callback/microsoft-entra-id

# Live presence (optional — map cursors when set)
# LIVEBLOCKS_SECRET_KEY=""

# Guest sign-in (display name only) + /join/ guest links on Share (enable on production App Service)
# GUEST_AUTH_ENABLED="true"

# Azure OpenAI (optional — other features; Discovery is via Cursor chat, see CURSOR_DISCOVERY.md)
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT=""

# Figma import (optional — users can also set PAT in Settings)
FIGMA_PERSONAL_ACCESS_TOKEN=""